# Máy chủ PRODUCTION: ứng dụng chỉ gọi PHP API; PHP mới được kết nối MySQL.
# Không đặt host, username hoặc mật khẩu MySQL trong ứng dụng Electron.
VITE_SERVER_ENV=production
VITE_DEMO_MODE=false
VITE_DATA_BACKEND=api
VITE_API_BASE_URL=https://YOUR_PRODUCTION_DOMAIN/api/app/v1
VITE_GLASS_LOOKUP_API_URL=https://YOUR_PRODUCTION_DOMAIN/api/glass-lookup
# Ghi đè rỗng để build production không đóng kèm cấu hình Supabase từ .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
