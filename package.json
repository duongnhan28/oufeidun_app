{
  "name": "kinh-ban-hang",
  "productName": "Oufeidun",
  "version": "0.1.5",
  "description": "Ứng dụng desktop quản lý kho và bán kính cường lực",
  "author": "AppBanHang",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "start": "npm run build && node scripts/start-demo.cjs",
    "demo": "npm run build && node scripts/start-demo.cjs",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:electron": "node scripts/smoke-electron.cjs",
    "verify": "npm run test && npm run test:ui && npm run test:electron && npm run build && npm audit --omit=dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.4.1",
    "pg": "^8.16.3",
    "png-to-ico": "^3.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  }
}
