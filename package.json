{
  "name": "kinh-ban-hang",
  "productName": "Oufeidun",
  "version": "0.1.3",
  "description": "Ứng dụng desktop quản lý kho và bán kính cường lực",
  "author": "Oufeidun",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:test": "npm run build:test && electron .",
    "desktop:production": "npm run build:production && electron .",
    "start": "npm run build && node scripts/start-demo.cjs",
    "demo": "npm run build && node scripts/start-demo.cjs",
    "build": "tsc --noEmit && vite build && node scripts/write-runtime-config.cjs",
    "build:electron-test": "tsc --noEmit && vite build --mode test && node scripts/write-runtime-config.cjs test",
    "build:test": "node scripts/validate-server-config.cjs test-supabase && tsc --noEmit && vite build --mode test-supabase && node scripts/write-runtime-config.cjs test-supabase",
    "build:local": "node scripts/validate-server-config.cjs local-mysql && tsc --noEmit && vite build --mode local-mysql && node scripts/write-runtime-config.cjs local-mysql",
    "build:production": "node scripts/validate-server-config.cjs production-mysql && tsc --noEmit && vite build --mode production-mysql && node scripts/write-runtime-config.cjs production-mysql",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:test": "npm run build:test && electron-forge make",
    "make:local": "npm run build:local && electron-forge make",
    "make:production": "npm run build:production && electron-forge make",
    "make:signed": "node scripts/make-signed.cjs",
    "make:production:signed": "node scripts/make-signed.cjs make:production",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:ui": "playwright test",
    "test:electron": "npm run build:electron-test && node scripts/smoke-electron.cjs",
    "test:electron:local": "npm run build:local && node scripts/smoke-local-electron.cjs",
    "verify": "npm run test && npm run test:ui && npm run test:electron && npm run build && npm audit --omit=dev",
    "test:lan": "node --test tests/lan-discovery.test.cjs",
    "server:migrate": "node server/src/migrate.cjs",
    "server:start": "node server/src/index.cjs",
    "server:check": "node --check server/src/index.cjs && node --check server/src/mutations.cjs && node --check server/src/services.cjs",
    "server:test": "node --test tests/local-server.test.cjs",
    "server:test:integration": "node --test tests/local-api.integration.cjs",
    "server:seed": "node server/src/seed-sample.cjs",
    "supabase:verify": "node scripts/verify-supabase-parity.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.4.1",
    "pg": "^8.16.3",
    "png-to-ico": "^3.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "@electron/asar": {
      "glob": {
        ".": "7.2.0",
        "minimatch": "3.1.5"
      }
    },
    "exceljs": {
      "minimatch": "11.0.1"
    },
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "uuid": "11.1.1"
  }
}
