# Chỉ chứa cấu hình public được đóng gói trong ứng dụng. Không đặt mật khẩu DB, service_role hay APP_KEY tại đây.
VITE_DEMO_MODE=false
VITE_DATA_BACKEND=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_API_BASE_URL=https://ten-mien-cua-ban.vn/api/app/v1
VITE_GLASS_LOOKUP_API_URL=https://ten-mien-cua-ban.vn/api/glass-lookup
# Chỉ dùng khi build bản Windows phát hành có chữ ký số.
# Không lưu file .pfx hoặc mật khẩu thật vào Git.
WINDOWS_CERTIFICATE_FILE=
WINDOWS_CERTIFICATE_PASSWORD=
WINDOWS_TIMESTAMP_SERVER=http://timestamp.digicert.com
